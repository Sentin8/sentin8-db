{
  "openapi": "3.1.0",
  "info": {
    "title": "sentin8-db",
    "description": "Sentin8 Sentin8:DB — structured persistence over PostgreSQL with RLS.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/audit": {
      "get": {
        "tags": [
          "db"
        ],
        "summary": "`GET /v1/audit` — DDL audit log (Stories).\nHandle audit log.",
        "operationId": "audit.list",
        "parameters": [
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DDL audit log"
          },
          "403": {
            "description": "Missing db:audit:read scope"
          }
        },
        "security": [
          {
            "sentin8:db:audit:read": []
          }
        ]
      }
    },
    "/v1/data/delete": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "Delete it.",
        "operationId": "data.delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rows deleted"
          },
          "403": {
            "description": "Missing db:data:write scope"
          }
        },
        "security": [
          {
            "sentin8:db:data:write": []
          }
        ]
      }
    },
    "/v1/data/insert": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "`POST /v1/data/insert` — insert rows with mandatory system columns.",
        "description": "Each row is split per design : `env_id` system column, the full JSON\nbody into `data`, and any keys matching a declared typed column into that\ncolumn. Typed columns are resolved from the physical table schema at\ninsert time.\nHandle insert.",
        "operationId": "data.insert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rows inserted"
          },
          "403": {
            "description": "Missing db:data:write scope"
          }
        },
        "security": [
          {
            "sentin8:db:data:write": []
          }
        ]
      }
    },
    "/v1/data/query": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "`POST /v1/data/query` — query rows with filters, sorts, pagination.\nSoft-deleted rows (`deleted_at IS NOT NULL`) are excluded.\nHandle query.",
        "operationId": "data.query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Query results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing db:data:read scope"
          }
        },
        "security": [
          {
            "sentin8:db:data:read": []
          }
        ]
      }
    },
    "/v1/data/update": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "Update it.",
        "operationId": "data.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rows updated"
          },
          "403": {
            "description": "Missing db:data:write scope"
          }
        },
        "security": [
          {
            "sentin8:db:data:write": []
          }
        ]
      }
    },
    "/v1/posture": {
      "get": {
        "tags": [
          "db"
        ],
        "summary": "`GET /v1/posture` — RLS drift detection (Stories).\nHandle posture.",
        "operationId": "posture.get",
        "parameters": [
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "RLS posture report"
          },
          "403": {
            "description": "Missing db:table:admin or db:posture:read scope"
          }
        },
        "security": [
          {
            "sentin8:db:posture:read": []
          }
        ]
      }
    },
    "/v1/tables": {
      "get": {
        "tags": [
          "db"
        ],
        "summary": "`GET /v1/tables` — list active tables for the resolved env.\nList tables.",
        "operationId": "table.list",
        "parameters": [
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TableResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "sentin8:db:data:read": []
          }
        ]
      },
      "post": {
        "tags": [
          "db"
        ],
        "summary": "`POST /v1/tables` — create a table with mandatory system columns + RLS.",
        "description": "Creates the physical PostgreSQL table with the mandatory system column set\n(`id`, `env_id`, `data` JSONB, `created_at`, `updated_at`,\n`resource_version`, `deleted_at`), enables + forces RLS, creates the four\nenv-scoped policies, registers the table in `table_registry`, writes the\n`create` DDL audit row, and emits the `sentin8:db:table:created` event —\nregistry, audit, and event all in the SAME transaction as the domain\nchange.\nCreate table.",
        "operationId": "table.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Table created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing db:table:admin scope"
          }
        },
        "security": [
          {
            "sentin8:db:table:admin": []
          }
        ]
      }
    },
    "/v1/tables/{id}": {
      "get": {
        "tags": [
          "db"
        ],
        "summary": "`GET /v1/tables/{id}` — get table metadata. Env-scoped + authenticated\n; a foreign-env id 404s.\nFetch table.",
        "operationId": "table.get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Table ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Table metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing db:data:read scope"
          },
          "404": {
            "description": "Table not found"
          }
        },
        "security": [
          {
            "sentin8:db:data:read": []
          }
        ]
      }
    },
    "/v1/tables/{id}/alter": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "Handle alter table.",
        "operationId": "table.alter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Table ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlterTableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Table altered"
          },
          "403": {
            "description": "Missing db:table:admin scope"
          },
          "404": {
            "description": "Table not found"
          }
        },
        "security": [
          {
            "sentin8:db:table:admin": []
          }
        ]
      }
    },
    "/v1/tables/{id}/archive": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "`POST /v1/tables/{id}/archive` — mark a table as archived (Stories).\nEnv-scoped; registry update, audit row, and event commit together.\nArchive table.",
        "operationId": "table.archive",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Table ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Table archived"
          },
          "403": {
            "description": "Missing db:table:admin scope"
          },
          "404": {
            "description": "Table not found or not active"
          }
        },
        "security": [
          {
            "sentin8:db:table:admin": []
          }
        ]
      }
    },
    "/v1/tables/{id}/drop": {
      "post": {
        "tags": [
          "db"
        ],
        "summary": "`POST /v1/tables/{id}/drop` — pending-delete then drop (Stories).\nEnv-scoped; registry status, physical DROP, audit row, and event commit\ntogether — a failed DROP rolls the registry status back.\nHandle drop table.",
        "operationId": "table.drop",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Table ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Table dropped"
          },
          "403": {
            "description": "Missing db:table:admin scope"
          },
          "404": {
            "description": "Table not found or already dropped"
          }
        },
        "security": [
          {
            "sentin8:db:table:admin": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AlterTableRequest": {
        "type": "object",
        "description": "`POST /v1/tables/{id}/alter` — safe schema alteration (ADD COLUMN only).\nEnv-scoped; audited + event emitted in the same transaction.\nRequest body for altertable.",
        "required": [
          "add_columns"
        ],
        "properties": {
          "add_columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnDef"
            },
            "description": "The add columns."
          }
        }
      },
      "ColumnDef": {
        "type": "object",
        "description": "One column definition of a created table.",
        "required": [
          "name",
          "data_type",
          "nullable"
        ],
        "properties": {
          "data_type": {
            "type": "string",
            "description": "Logical data type."
          },
          "default": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional SQL default expression."
          },
          "name": {
            "type": "string",
            "description": "Column name."
          },
          "nullable": {
            "type": "boolean",
            "description": "Whether nulls are allowed."
          }
        }
      },
      "CreateTableRequest": {
        "type": "object",
        "description": "Request body for createtable.",
        "required": [
          "table_name",
          "display_name"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnDef"
            },
            "description": "The columns."
          },
          "display_name": {
            "type": "string",
            "description": "The display name."
          },
          "table_name": {
            "type": "string",
            "description": "The table name."
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "description": "`POST /v1/data/delete` — soft-delete rows by filter (`deleted_at = now`).\nNo hard-delete fallback: physical removal happens only via the controlled\ndrop flow.\nRequest body for delete.",
        "required": [
          "table"
        ],
        "properties": {
          "filter": {
            "description": "The filter."
          },
          "table": {
            "type": "string",
            "description": "The table."
          }
        }
      },
      "InsertRequest": {
        "type": "object",
        "description": "Request body for insert.",
        "required": [
          "table",
          "rows"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {},
            "description": "The rows."
          },
          "table": {
            "type": "string",
            "description": "The table."
          }
        }
      },
      "Pagination": {
        "type": "object",
        "description": "Limit/offset pagination window.",
        "properties": {
          "after": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Keyset cursor (DB-3, db README §7): return rows strictly after this\n`id`. Takes precedence over `offset` when set — stable under inserts\nbetween pages, unlike the offset window. Paired with `sort` on `id`\nenforced server-side when the cursor is used."
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Maximum rows to return.",
            "minimum": 0
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Rows to skip (offset mode).",
            "minimum": 0
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/data/query`.",
        "required": [
          "table"
        ],
        "properties": {
          "filters": {
            "description": "Opaque filter expression (the server interprets per table)."
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination",
            "description": "Limit/offset window."
          },
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortClause"
            },
            "description": "Sort clauses in priority order."
          },
          "table": {
            "type": "string",
            "description": "The table to query."
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "description": "Response from `POST /v1/data/query`.",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Keyset cursor (DB-3): the last returned row's `id` — pass it back as\n`pagination.after` to fetch the next page. `null` when the page was\nthe last (fewer rows than `limit` returned)."
          },
          "rows": {
            "type": "array",
            "items": {},
            "description": "The matched rows as JSON objects."
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total matching row count (ignoring pagination).",
            "minimum": 0
          }
        }
      },
      "SortClause": {
        "type": "object",
        "description": "One sort instruction.",
        "required": [
          "column"
        ],
        "properties": {
          "column": {
            "type": "string",
            "description": "Column to sort by."
          },
          "descending": {
            "type": "boolean",
            "description": "Sort descending when true (default ascending)."
          }
        }
      },
      "TableResponse": {
        "type": "object",
        "description": "Response payload for table.",
        "required": [
          "id",
          "table_name",
          "display_name",
          "status"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "The display name."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier."
          },
          "status": {
            "type": "string",
            "description": "The status."
          },
          "table_name": {
            "type": "string",
            "description": "The table name."
          }
        }
      },
      "UpdateRequest": {
        "type": "object",
        "description": "`POST /v1/data/update` — update rows by filter with resource version check.\nRequest body for update.",
        "required": [
          "table",
          "set"
        ],
        "properties": {
          "filter": {
            "description": "The filter."
          },
          "resource_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The resource version."
          },
          "set": {
            "description": "The set."
          },
          "table": {
            "type": "string",
            "description": "The table."
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "db",
      "description": "Sentin8:DB admin API — tables, data CRUD, posture, audit"
    }
  ]
}
